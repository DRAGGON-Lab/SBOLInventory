@prefix ex: <https://example.org/invalid-17005/> .
@prefix fac: <https://sbol.io/ns/facility#> .
@prefix inv: <https://sbol.io/ns/inventory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sbol: <http://sbols.org/v3#> .

ex:facility
    a sbol:TopLevel, fac:Facility ;
    sbol:displayId "facility" ;
    sbol:hasNamespace <https://example.org/invalid-17005> .

ex:room
    a sbol:TopLevel, fac:Zone ;
    sbol:displayId "room" ;
    sbol:hasNamespace <https://example.org/invalid-17005> ;
    fac:facility ex:facility ;
    fac:zoneKind fac:Room ;
    fac:isActive true .

ex:workstation
    a sbol:TopLevel, fac:Asset ;
    sbol:displayId "workstation" ;
    sbol:hasNamespace <https://example.org/invalid-17005> ;
    fac:assetKind fac:Workstation ;
    fac:locatedIn ex:room ;
    fac:isActive true .

ex:design
    a sbol:Component ;
    sbol:displayId "design" ;
    sbol:hasNamespace <https://example.org/invalid-17005> ;
    sbol:type <https://identifiers.org/SBO:0000251> .

ex:lot
    a sbol:Implementation ;
    sbol:displayId "lot" ;
    sbol:hasNamespace <https://example.org/invalid-17005> ;
    sbol:built ex:design ;
    fac:materialKind inv:BacterialStock ;
    fac:locatedIn ex:room ;
    fac:isActive true ;
    prov:wasGeneratedBy ex:run .

ex:run
    a sbol:TopLevel, prov:Activity ;
    sbol:displayId "run" ;
    sbol:hasNamespace <https://example.org/invalid-17005> ;
    prov:qualifiedUsage <https://example.org/invalid-17005/run/asset_usage>, <https://example.org/invalid-17005/run/input_usage> .

<https://example.org/invalid-17005/run/asset_usage>
    a sbol:Identified, prov:Usage ;
    sbol:displayId "asset_usage" ;
    prov:entity ex:workstation ;
    prov:hadRole fac:RunAsset .

<https://example.org/invalid-17005/run/input_usage>
    a sbol:Identified, prov:Usage ;
    sbol:displayId "input_usage" ;
    prov:entity ex:lot ;
    prov:hadRole fac:RunInputMaterial .
